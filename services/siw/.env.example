# siw 서비스 환경변수 예시
# 실제 값은 .env.local에 설정 (이 파일은 커밋용 템플릿)

# ── 엔진 ────────────────────────────────────────────────
ENGINE_BASE_URL=http://localhost:8000

# ── Supabase ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Engine / LLM ────────────────────────────────────────────────
# OPENROUTER_API_KEY는 엔진(.env)에서 관리 — LLM + 임베딩(baai/bge-m3) 통합 키

# ── LLM Observability (optional — 미설정 시 로컬 파일 fallback) ──
S3_LOG_BUCKET=           # e.g. mirai-logs
S3_LOG_PREFIX=llm-events # S3 key prefix (default: llm-events)
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── RAG (optional — Pipeline 2-2 배포 시 true로 설정) ───────────
# ENABLE_RAG=true

# ── RAG 공용 Supabase (팀원 공유 — 개인 DB와 별도) ───────────────
# job_posting_embeddings, accepted_resume_embeddings 저장용
# RAG_DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
